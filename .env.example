# Local 12-KOUL defaults. Copy to .env; Uvicorn --env-file .env loads it.
# Existing exported variables take precedence. Never commit .env or a real key.
LLM_PROVIDER=groq
# Fill GROQ_API_KEY locally. For offline greeting only, set LLM_PROVIDER=mock.
# Other compatible service: LLM_PROVIDER=compatible, LLM_API_KEY=<local secret>.
GROQ_API_KEY=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Raw HTTPS URL only, without Markdown brackets or /chat/completions suffix.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
LLM_OVERALL_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Production prompt is fixed to V3 in the API; no environment override.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
